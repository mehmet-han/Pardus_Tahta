# ============================================================================
# Pardus-benzeri (Debian 12) izole Nuitka build ortami — §9.4 obfuscation testi
# ============================================================================
# Pardus, Debian tabanlidir; bu imaj client.py'nin Linux/Nuitka derlemesini
# host'a hic dokunmadan, tekrarlanabilir sekilde kanitlar.
#
# Kullanim (Docker calisirken):
#   docker build -f Dockerfile.pardus-build -t tahta-nuitka .
#   docker run --rm tahta-nuitka           # derler + client.bin --test calistirir
# ----------------------------------------------------------------------------
FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python3-pyqt5 \
        gcc patchelf ccache ca-certificates ntpsec-ntpdate \
    && rm -rf /var/lib/apt/lists/*

# requests/urllib3 DERLEME ANINDA kurulu olmali ki Nuitka standalone'a gomsun.
RUN pip3 install --break-system-packages --no-cache-dir nuitka ordered-set requests urllib3

WORKDIR /app
COPY client.py platform_layer.py config.ini version.txt ./

# Derle (standalone + PyQt5). resources GUI icindir, --test'te gerekmez.
RUN python3 -m nuitka --standalone --enable-plugin=pyqt5 \
        --assume-yes-for-downloads --output-dir=nuitka_build --remove-output client.py

# Konteyner calisinca: derlenen ikiliyi --test ile dogrula (pencere yok).
CMD ["sh", "-c", "./nuitka_build/client.dist/client.bin --test; echo '--- strings kanit (pardus2026 gecmemeli):'; strings nuitka_build/client.dist/client.bin | grep -c pardus2026 || true"]
